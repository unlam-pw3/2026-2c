@model Animal

<h1>Agregar animal</h1>

<form asp-action="Agregar" method="post">

    <div class="mb-3">
        <label asp-for="Raza" class="form-label"></label>
        <input asp-for="Raza" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Peso" class="form-label"></label>
        <input asp-for="Peso" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="EdadEstimada" class="form-label"></label>
        <input asp-for="EdadEstimada" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="UrlImagen" class="form-label"></label>
        <input asp-for="UrlImagen" class="form-control" />
    </div>

    <div class="form-check mb-3">
        <input asp-for="EnExtincion" class="form-check-input" />
        <label asp-for="EnExtincion" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
