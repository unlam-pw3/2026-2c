@{
    Layout = "_LayoutAnimales";
}


@model ClaseMVC.Entidades.Animal

<h1>Agregar Animal</h1>
<a href="/animales" class="btn btn-secondary mb-3">Volver</a>
    <div>
    <p>Los nacimientos del ultimos mes fueron de @ViewBag.NacimientosUltimoMes  </p>
  </div>
<form action="@Url.Action("Agregar", "Animales")" method="post">
    <div class="form-group">
        <label for="Raza">Raza</label>
        <input asp-for="Raza" class="form-control" />
        <span asp-validation-for="Raza" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label for="Peso">Peso</label>
        <input asp-for="Peso" class="form-control" />
        <span asp-validation-for="Peso" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label for="EdadEstimada">Edad Estimada</label>
        <input asp-for="EdadEstimada" class="form-control" />
        <span asp-validation-for="EdadEstimada" class="text-danger"></span>
    </div>
    <div class="form-group form-check">
        <input asp-for="EnExtincion" class="form-check-input" />
        <label class="form-check-label" for="EnExtincion">En Extinción</label>
    </div>
     <div class="form-group form-check">
       <label for="ImagenUrl">Imagen</label>
        <input asp-for="ImagenUrl" class="form-control" />
        <span asp-validation-for="ImagenUrl" class="text-danger"></span>
    </div>
    
    <button type="submit" class="btn btn-primary">Agregar Animal</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}