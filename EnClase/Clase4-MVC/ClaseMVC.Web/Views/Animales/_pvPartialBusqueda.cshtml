
<form action="@Url.Action("Buscar","Animales")" method="get" class="mb-3">
    <div class="form-group" mb-2>
        <label for="raza">Buscar por raza:</label>
        <input type="text" class="form-control" id="raza" name="raza" value="@ViewBag.Raza"/>
    </div>

    <button type="submit" class="btn btn-secondary">Buscar</button>

    <a href="@Url.Action("Index", "Animales")" class="btn btn-outline-secondary">Limpiar</a>
</form>

@* --- Resultado de la Búsqueda --- *@
@if (ViewBag.Raza != null){

    <div class="card my-3">
        <div class="card-header bg-light">
            <h5 class="mb-0">Resultado de la búsqueda para: "<strong>@ViewBag.Raza</strong>"</h5>
        </div>

        <div class="card-body">
            @if (ViewBag.AnimalBuscado != null) {

                var animal = ViewBag.AnimalBuscado as ClaseMVC.Entidades.Animal;

                if (animal != null) {
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Raza</th>
                                <th>Peso</th>
                                <th>Edad Estimada</th>
                                <th>En Extinción</th>
                                <th>Eliminar</th>
                            </tr>
                        </thead>
                        <tbody>
      
                                <tr>
                                    <td><partial name="_pvAnimalAvatar" model="animal" /></td>
                                    <td>@animal.Peso</td>
                                    <td>@animal.EdadEstimada</td>
                                    <td>@(animal.EnExtincion ? "Sí" : "No")</td>
                                    <td>
                                        <a href="/animales/eliminar/@animal.Id" class="btn btn-danger">Eliminar</a>
                                     </td>
                                </tr>
        
                        </tbody>
                    </table>
                    
                }
                
             }else{
                <p class="text-danger">No se encontró ningún animal con la raza "<strong>@ViewBag.Raza</strong>".</p>
             }
    </div>
    </div>
}




